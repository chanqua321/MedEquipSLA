{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ]
      },
      "equipment": {
        "ClusterId": "equipment",
        "Match": {
          "Path": "/equipment/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/equipment"
          }
        ]
      },
      "maintenance": {
        "ClusterId": "maintenance",
        "Match": {
          "Path": "/maintenance/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/maintenance"
          }
        ]
      },
      "incident": {
        "ClusterId": "incident",
        "Match": {
          "Path": "/incident/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/incident"
          }
        ]
      },
      "notification": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/notification/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/notification"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "equipment": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "maintenance": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "incident": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "notification": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5106"
          }
        }
      }
    }
  }
}
