digraph ERD { graph [rankdir=TB, bgcolor="white", pad=0.5, nodesep=0.55, ranksep=0.85, splines=polyline, fontname="Segoe UI", labelloc=t, fontsize=22]; node [shape=plain, fontname="Segoe UI"]; edge [fontname="Segoe UI", arrowsize=0.7, penwidth=1.3];
label="MedEquip_Incident — APPROVED / local FK only";
subgraph cluster_Incident { label="MedEquip_Incident | APPROVED v0.1"; fontname="Segoe UI"; fontsize=22; fontcolor="#774b9c"; style="rounded"; color="#bacbdc"; margin=24; Incident_SlaPolicies [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#ced8e4"><TR><TD COLSPAN="2" BGCOLOR="#774b9c"><FONT COLOR="white" POINT-SIZE="16"><B>SlaPolicies</B></FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT POINT-SIZE="12">Id<FONT COLOR="#4c5c72"> [PK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">Priority<FONT COLOR="#4c5c72"> [UK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">nvarchar(20)</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">Name</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">nvarchar(200)</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">IsEnabled</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">bit</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">CreatedAtUtc</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">datetimeoffset</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">UpdatedAtUtc</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">datetimeoffset</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT POINT-SIZE="12">CreatedByUserId<FONT COLOR="#4c5c72"> [REF]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier ?</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT POINT-SIZE="12">UpdatedByUserId<FONT COLOR="#4c5c72"> [REF]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier ?</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">RowVersion</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">rowversion</FONT></TD></TR></TABLE>>];
Incident_SlaPolicyVersions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#ced8e4"><TR><TD COLSPAN="2" BGCOLOR="#774b9c"><FONT COLOR="white" POINT-SIZE="16"><B>SlaPolicyVersions</B></FONT></TD></TR><TR><TD WIDTH="230" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT POINT-SIZE="12">SlaPolicyId<FONT COLOR="#4c5c72"> [PK,FK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="230" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT POINT-SIZE="12">Version<FONT COLOR="#4c5c72"> [PK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT COLOR="#607086" POINT-SIZE="11">int</FONT></TD></TR><TR><TD WIDTH="230" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">ResponseDurationMinutes</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">int</FONT></TD></TR><TR><TD WIDTH="230" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">ResolutionDurationMinutes</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">int</FONT></TD></TR><TR><TD WIDTH="230" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">EffectiveFromUtc</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">datetimeoffset</FONT></TD></TR><TR><TD WIDTH="230" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">EffectiveToUtc</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">datetimeoffset ?</FONT></TD></TR><TR><TD WIDTH="230" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT POINT-SIZE="12">CreatedByUserId<FONT COLOR="#4c5c72"> [REF]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="230" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">CreatedAtUtc</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">datetimeoffset</FONT></TD></TR></TABLE>>];
Incident_Incidents [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#ced8e4"><TR><TD COLSPAN="2" BGCOLOR="#774b9c"><FONT COLOR="white" POINT-SIZE="16"><B>Incidents</B></FONT></TD></TR><TR><TD WIDTH="239" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT POINT-SIZE="12">Id<FONT COLOR="#4c5c72"> [PK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="239" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">Code<FONT COLOR="#4c5c72"> [UK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">nvarchar(50)</FONT></TD></TR><TR><TD WIDTH="239" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT POINT-SIZE="12">EquipmentId<FONT COLOR="#4c5c72"> [REF]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="239" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT POINT-SIZE="12">DepartmentIdSnapshot<FONT COLOR="#4c5c72"> [REF]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="239" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT POINT-SIZE="12">AssignedTechnicianId<FONT COLOR="#4c5c72"> [REF]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier ?</FONT></TD></TR><TR><TD WIDTH="239" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">Status</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">nvarchar(20)</FONT></TD></TR><TR><TD WIDTH="239" ALIGN="LEFT" BGCOLOR="#e9f7f1"><FONT POINT-SIZE="12">SlaPolicyId<FONT COLOR="#4c5c72"> [FK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#e9f7f1"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="239" ALIGN="LEFT" BGCOLOR="#e9f7f1"><FONT POINT-SIZE="12">SlaPolicyVersion<FONT COLOR="#4c5c72"> [FK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#e9f7f1"><FONT COLOR="#607086" POINT-SIZE="11">int</FONT></TD></TR><TR><TD WIDTH="239" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">ResponseDeadlineAtUtc</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">datetimeoffset</FONT></TD></TR><TR><TD WIDTH="239" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">ResolutionDeadlineAtUtc</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">datetimeoffset</FONT></TD></TR><TR><TD WIDTH="239" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">ResolutionOutcome</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">nvarchar(20)</FONT></TD></TR><TR><TD WIDTH="239" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">RowVersion</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">rowversion</FONT></TD></TR></TABLE>>];
Incident_ResolutionAttempts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#ced8e4"><TR><TD COLSPAN="2" BGCOLOR="#774b9c"><FONT COLOR="white" POINT-SIZE="16"><B>ResolutionAttempts</B></FONT></TD></TR><TR><TD WIDTH="214" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT POINT-SIZE="12">Id<FONT COLOR="#4c5c72"> [PK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="214" ALIGN="LEFT" BGCOLOR="#e9f7f1"><FONT POINT-SIZE="12">IncidentId<FONT COLOR="#4c5c72"> [FK,UK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#e9f7f1"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="214" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">AttemptNumber<FONT COLOR="#4c5c72"> [UK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">int</FONT></TD></TR><TR><TD WIDTH="214" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT POINT-SIZE="12">PerformedByUserId<FONT COLOR="#4c5c72"> [REF]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="214" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">ResolutionNotes</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">nvarchar(4000)</FONT></TD></TR><TR><TD WIDTH="214" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">ResultSummary</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">nvarchar(2000)</FONT></TD></TR><TR><TD WIDTH="214" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">CompletedAtUtc</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">datetimeoffset</FONT></TD></TR><TR><TD WIDTH="214" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">ReviewDecision</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">nvarchar(20)</FONT></TD></TR><TR><TD WIDTH="214" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT POINT-SIZE="12">ReviewedByUserId<FONT COLOR="#4c5c72"> [REF]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier ?</FONT></TD></TR><TR><TD WIDTH="214" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">ReviewedAtUtc</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">datetimeoffset ?</FONT></TD></TR><TR><TD WIDTH="214" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">ReviewReason</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">nvarchar(2000) ?</FONT></TD></TR><TR><TD WIDTH="214" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">RowVersion</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">rowversion</FONT></TD></TR></TABLE>>];
Incident_IncidentActivities [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#ced8e4"><TR><TD COLSPAN="2" BGCOLOR="#774b9c"><FONT COLOR="white" POINT-SIZE="16"><B>IncidentActivities</B></FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT POINT-SIZE="12">Id<FONT COLOR="#4c5c72"> [PK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#e9f7f1"><FONT POINT-SIZE="12">IncidentId<FONT COLOR="#4c5c72"> [FK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#e9f7f1"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">Action</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">nvarchar(50)</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">FromStatus</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">nvarchar(20) ?</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">ToStatus</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">nvarchar(20) ?</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT POINT-SIZE="12">ActorUserId<FONT COLOR="#4c5c72"> [REF]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#fff3dd"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">OccurredAtUtc</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">datetimeoffset</FONT></TD></TR></TABLE>>];
Incident_SlaDeadlineAlerts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#ced8e4"><TR><TD COLSPAN="2" BGCOLOR="#774b9c"><FONT COLOR="white" POINT-SIZE="16"><B>SlaDeadlineAlerts</B></FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT POINT-SIZE="12">Id<FONT COLOR="#4c5c72"> [PK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#edf2ff"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#e9f7f1"><FONT POINT-SIZE="12">IncidentId<FONT COLOR="#4c5c72"> [FK,UK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#e9f7f1"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">AlertKind<FONT COLOR="#4c5c72"> [UK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">nvarchar(20)</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">DeadlineAtUtc</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">datetimeoffset</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">DetectedAtUtc</FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">datetimeoffset</FONT></TD></TR><TR><TD WIDTH="210" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT POINT-SIZE="12">EventId<FONT COLOR="#4c5c72"> [UK]</FONT></FONT></TD><TD WIDTH="150" ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#607086" POINT-SIZE="11">uniqueidentifier</FONT></TD></TR></TABLE>>];
Incident_SlaPolicies -> Incident_SlaPolicyVersions [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="SlaPolicyId", fontsize=10, color="#657b90", fontcolor="#506579", labeldistance=2.0];
Incident_SlaPolicyVersions -> Incident_Incidents [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="SlaPolicyId, SlaPolicyVersion", fontsize=10, color="#657b90", fontcolor="#506579", labeldistance=2.0];
Incident_Incidents -> Incident_Incidents [dir=both, arrowtail="teeodot", arrowhead="crowodot", taillabel="0..1", headlabel="0..N", label="RelatedIncidentId", fontsize=10, color="#657b90", fontcolor="#506579", labeldistance=2.0];
Incident_Incidents -> Incident_ResolutionAttempts [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="IncidentId", fontsize=10, color="#657b90", fontcolor="#506579", labeldistance=2.0];
Incident_Incidents -> Incident_IncidentActivities [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="IncidentId", fontsize=10, color="#657b90", fontcolor="#506579", labeldistance=2.0];
Incident_Incidents -> Incident_SlaDeadlineAlerts [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..N", label="IncidentId", fontsize=10, color="#657b90", fontcolor="#506579", labeldistance=2.0];
Incident_technical [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#c9d5df", label="Owned technical tables (separate local copies)\nAuditEntries\nIdempotencyRequests\nOutboxMessages\nSee TECHNICAL-TABLES.md for all columns"];
}
