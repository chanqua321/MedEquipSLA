# Copy to .env locally. Fill unique strong values; never commit .env.
# Passwords: at least 16 characters, upper/lower/digit/symbol; avoid quotes, $, ; and spaces for this SQLCMD bootstrap.
MSSQL_SA_PASSWORD=
IDENTITY_DB_PASSWORD=
EQUIPMENT_DB_PASSWORD=
MAINTENANCE_DB_PASSWORD=
INCIDENT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
# Random secret shared only by Incident and Equipment for the internal registration RPC.
INCIDENT_REGISTRATION_KEY=
# Separate random secret shared by Maintenance and Equipment.
MAINTENANCE_REGISTRATION_KEY=
# Worker-only WorkOrder key; separate from user-authorized Schedule registration.
MAINTENANCE_WORKORDER_KEY=
# Source-bound retirement credentials. Each key is shared only with Equipment and its named source.
RETIREMENT_MAINTENANCE_KEY=
RETIREMENT_INCIDENT_KEY=
# Separate internal read-only recipient lookup secret for Identity, Maintenance, Notification.
NOTIFICATION_RECIPIENT_LOOKUP_KEY=
# SMTP is opt-in. Keep disabled until a sender and server have been configured.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
PUBLIC_WEB_ADDRESS=http://localhost:5173
