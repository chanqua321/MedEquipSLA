        <mxCell id="owner_Incident" value="Incident — MedEquip_Incident&lt;br/&gt;11 bảng ứng dụng; 6 FK nội bộ; 1 EF history" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;spacing=12;" vertex="1" parent="1">
