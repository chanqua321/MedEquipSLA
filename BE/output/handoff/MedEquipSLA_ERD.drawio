<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device" agent="MedEquipSLA">
  <diagram id="00ĐọcERD" name="00 Đọc ERD">
    <mxGraphModel grid="1" gridSize="10" page="0" connect="1" arrows="1" fold="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="MedEquipSLA — ERD vật lý SQL Server&lt;br/&gt;Cập nhật schema 07/11/2026" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="2600" height="130" as="geometry" />
        </mxCell>
        <mxCell id="guide" value="Mỗi tab service chứa toàn bộ bảng/cột phía trên và từng quan hệ FK ở các panel riêng phía dưới. Panel lặp lại đúng các cột tham gia khóa để đọc quan hệ; không phải bảng mới. Mỗi FK có một connector độc lập, neo trực tiếp vào dòng khóa; không connector nào nối vào connector khác.&lt;br/&gt;PK: khóa chính. FK: khóa ngoại nội bộ. UK: unique/filtered index (xem dictionary SQL). REF: ID logic service khác, không phải SQL FK. Vạch = một, vòng tròn = tùy chọn, chân quạ = nhiều. FK ghép được liệt kê đầy đủ trong tên panel. Tất cả DeleteBehavior.NoAction.&lt;br/&gt;Nguồn: docs/database/erd-model.json, EF configurations/migrations và SQL schema tests. 54 bảng ứng dụng + 5 EF history. Schema tests so sánh nullability, kiểu SQL, FK, index/check và rowversion. Database ứng dụng vẫn InitialCreate; schema mới đã chạy trên database test SQL Server 2022. ERD không tự apply database." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="190" width="2600" height="360" as="geometry" />
        </mxCell>
        <mxCell id="owner_Identity" value="Identity — MedEquip_Identity&lt;br/&gt;11 bảng ứng dụng; 8 FK nội bộ; 1 EF history" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="2600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="owner_Equipment" value="Equipment — MedEquip_Equipment&lt;br/&gt;13 bảng ứng dụng; 9 FK nội bộ; 1 EF history" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="740" width="2600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="owner_Maintenance" value="Maintenance — MedEquip_Maintenance&lt;br/&gt;12 bảng ứng dụng; 6 FK nội bộ; 1 EF history" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="880" width="2600" height="120" as="geometry" />
